DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=example.com,www.example.com
MYSQL_DATABASE=infosaas
MYSQL_USER=infosaas
MYSQL_PASSWORD=change-me
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
REDIS_URL=redis://127.0.0.1:6379/0
DJANGO_SECURE_SSL_REDIRECT=True
DJANGO_SECURE_HSTS_SECONDS=31536000
DJANGO_SECURE_HSTS_INCLUDE_SUBDOMAINS=True
DJANGO_SECURE_HSTS_PRELOAD=False
DJANGO_SESSION_COOKIE_SECURE=True
DJANGO_CSRF_COOKIE_SECURE=True
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_ENVIRONMENT=test
SUBSCRIPTION_GRACE_DAYS=7
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=Press Nexa <no-reply@example.com>
SERVER_EMAIL=Press Nexa <no-reply@example.com>

# Track public Press Nexa visits separately from tenant article analytics.
PLATFORM_VISITOR_TRACKING_ENABLED=True

# Google Analytics loads only on SITE_BASE_URL's host and public platform pages.
GOOGLE_ANALYTICS_MEASUREMENT_ID=G-7839WK8E1T
GOOGLE_ANALYTICS_ENABLED=True
