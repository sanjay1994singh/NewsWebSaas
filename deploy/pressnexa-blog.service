[Unit]
Description=Publish due Press Nexa marketing articles
After=network.target mysql.service

[Service]
Type=oneshot
User=www-data
Group=www-data
WorkingDirectory=/var/www/NewsWebSaas
EnvironmentFile=/var/www/NewsWebSaas/.env
ExecStart=/var/www/NewsWebSaas/venv/bin/python manage.py publish_blog

